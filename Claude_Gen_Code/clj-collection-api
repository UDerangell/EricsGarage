 :db/cardinality :db.cardinality/one}
 ;; :relocated :loaned-out :returned :sold :disposed

{:db/ident :movement/due-date
 :db/valueType :db.type/instant
 :db/cardinality :db.cardinality/one}

{:db/ident :movement/notes
